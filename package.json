{
  "name": "zap-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build zap",
    "build:lib:watch": "ng build zap --watch && cd dist/zap && npm link",
    "start:demo": "ng serve demo",
    "publish": "ng build zap && cd dist/zap && npm publish --tag latest",
    "publish:alpha": "ng build zap && cd dist/zap && npm publish --tag dev-alpha",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:watch": "ng test --watch",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.5",
    "@angular/cdk": "^18.2.5",
    "@angular/common": "^18.2.5",
    "@angular/compiler": "^18.2.5",
    "@angular/core": "^18.2.5",
    "@angular/forms": "^18.2.5",
    "@angular/platform-browser": "^18.2.5",
    "@angular/platform-browser-dynamic": "^18.2.5",
    "@angular/router": "^18.2.5",
    "@tailwindcss/forms": "^0.5.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular/cdk": "^18.2.5",
    "@angular-devkit/build-angular": "^18.2.5",
    "@angular-eslint/eslint-plugin": "^19.1.0",
    "@angular-eslint/eslint-plugin-template": "^19.1.0",
    "@angular-eslint/template-parser": "^19.1.0",
    "@angular/cli": "~18.2.5",
    "@angular/compiler-cli": "^18.2.5",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "angular-eslint": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^18.2.1",
    "postcss": "^8.5.1",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": ">=5.4 <5.6",
    "typescript-eslint": "^8.25.0"
  }
}
